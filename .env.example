# Copy to .env and fill in for your deployment. Nothing here is required for
# local dev/tests — the app runs with sane, safe-by-default values with no
# .env at all (cloud calls blocked, no cap = deny cloud, SQLite in ./data/).

# --- Core ---
GG_DB_PATH=data/guardedgateway.db
GG_ENCRYPTION_KEY=                 # Fernet key for BYOK provider keys — generate with:
                                    #   python -c "from guardedgateway.crypto import generate_key; print(generate_key())"
GG_CACHE_TTL_SECONDS=300

# --- Spend caps (the whole product claim: cannot overspend) ---
GG_MONTHLY_CAP_USD=                # global default cap in USD; per-key caps override this
GG_PRICING_FILE=                   # override the bundled pricing.yaml
GG_PROVIDERS_FILE=                 # override the bundled providers.yaml

# --- Cloud gate (BYOK cloud providers are default-deny) ---
GG_ALLOW_CLOUD=0                   # set to 1 to allow openai/anthropic/gemini calls at all
GG_OLLAMA_URL=http://localhost:11434

# --- Stripe billing (optional; falls back to PAYMENT_LINK_URL, then "not configured") ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_CLINIC=
STRIPE_PRICE_HEALTH_SYSTEM=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_WEBHOOK_SECRET=
PAYMENT_LINK_URL=
